# App and public URLs (no secrets in NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_EMAIL=support@instafetch.local

# Permitted extraction disabled by default until verified and authorized
EXTRACTOR_ENABLED=false
MAX_MEDIA_BYTES=104857600
MAX_CAROUSEL_ITEMS=10
EXTRACTION_TIMEOUT_SECONDS=45
MEDIA_TTL_MINUTES=30
RATE_LIMIT_PER_HOUR=10
MAX_CONCURRENT_INSPECTIONS=2

# Server secrets configured in Vercel dashboard, never checked into git
BLOB_READ_WRITE_TOKEN=
RATE_LIMIT_BACKEND_URL=
RATE_LIMIT_BACKEND_TOKEN=
CRON_SECRET=

# Optional durable jobs, ONLY if genuinely used
DATABASE_URL=
QUEUE_NAME=
